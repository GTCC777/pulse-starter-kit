# ── Your Virtuals ACP agent (from app.virtuals.io/acp) ──────────────────────────
# Register a Provider agent in the dashboard; it provisions a Smart Wallet.
SELLER_WALLET_ADDRESS=       # the agent's Smart Wallet address (0x…)
SELLER_WALLET_ID=            # the agent's Smart Wallet id (agent settings)
SELLER_SIGNER_PRIVATE_KEY=   # a FRESH EOA key you generate + add under the Signers tab

# ── How you pay PulseNetwork for the calls you resell (set at least one) ─────────
# WHOLESALE (recommended): near-$0 per call, keep the full markup. Request a key — see README.
PULSE_INTERNAL_KEY=
# AFFILIATE/REV-SHARE: your referral code; every referred call earns you a rev-share.
PULSE_REFERRAL_CODE=

# ── Optional ────────────────────────────────────────────────────────────────────
# CATALOG_PATH=./catalog.json   # point at a different catalog file
